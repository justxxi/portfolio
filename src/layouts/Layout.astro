---
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
  path?: string
}

const {
  title = 'justxxi — full-stack developer',
  description = 'Full-stack developer building backends, CLI tools, and AI systems in Python, Go, and TypeScript.',
  path = Astro.url.pathname
}: Props = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://justxxii.localplayer.dev'
const canonical = `${siteUrl}${path}`
const ogImage = `${siteUrl}/og.svg`
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0e0d" />
    <meta name="description" content={description} />
    <meta name="author" content="justxxi" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="justxxi" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="justxxi — full-stack developer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" sizes="180x180" href="/touch-icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <slot />

    <div class="modal-overlay" id="project-modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="modal-card">
        <button class="modal-close" id="modal-close-btn" aria-label="Close modal">&times;</button>
        <div class="modal-header">
          <span class="modal-badge font-mono" id="modal-badge">FEATURED</span>
          <div>
            <h3 class="modal-title font-display" id="modal-title">Project Name</h3>
            <p class="modal-tagline" id="modal-tagline">Project Tagline</p>
          </div>
        </div>
        <p class="modal-desc text-body" id="modal-desc">Project Description</p>
        <div class="modal-section">
          <h4 class="modal-subhead font-mono">TECHNOLOGY STACK</h4>
          <div class="modal-tags" id="modal-tags"></div>
        </div>
        <div class="modal-footer">
          <a class="pill pill--primary" id="modal-repo-btn" href="#" target="_blank" rel="noopener noreferrer">
            <span>View GitHub Repository</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="cmd-overlay" id="cmd-palette" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="cmd-card">
        <div class="cmd-header">
          <span class="cmd-icon">🔍</span>
          <input type="text" id="cmd-input" placeholder="Type a command or search..." autocomplete="off" />
          <span class="cmd-badge font-mono">ESC</span>
        </div>
        <div class="cmd-list" id="cmd-list">
          <button class="cmd-item" data-action="projects">
            <span class="cmd-item-icon">⚡</span>
            <span class="cmd-item-text">View Featured Projects</span>
            <span class="cmd-item-shortcut font-mono">#projects</span>
          </button>
          <button class="cmd-item" data-action="about">
            <span class="cmd-item-icon">👨‍💻</span>
            <span class="cmd-item-text">View About & Tech Stack</span>
            <span class="cmd-item-shortcut font-mono">#about</span>
          </button>
          <button class="cmd-item" data-action="contact">
            <span class="cmd-item-icon">✉</span>
            <span class="cmd-item-text">Get in Touch</span>
            <span class="cmd-item-shortcut font-mono">#contact</span>
          </button>
          <button class="cmd-item" data-action="copy-email">
            <span class="cmd-item-icon">📋</span>
            <span class="cmd-item-text">Copy Email (wyurtrft@proton.me)</span>
            <span class="cmd-item-shortcut font-mono">COPY</span>
          </button>
          <button class="cmd-item" data-action="github">
            <span class="cmd-item-icon">↗</span>
            <span class="cmd-item-text">Open GitHub Profile (github.com/justxxi)</span>
            <span class="cmd-item-shortcut font-mono">LINK</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      import '../scripts/animations'
    </script>
  </body>
</html>
