---
import '@fontsource/cormorant-garamond/500.css'
import '@fontsource/cormorant-garamond/600.css'
import '@fontsource/cormorant-garamond/500-italic.css'
import '@fontsource/hanken-grotesk/400.css'
import '@fontsource/hanken-grotesk/500.css'
import '@fontsource/jetbrains-mono/400.css'
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
  path?: string
}

const {
  title = 'justxxi · Full-stack & AI engineer',
  description = 'Full-stack engineer building web applications, cloud backends and custom AI models with Python, Go and TypeScript.',
  path = Astro.url.pathname
}: Props = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://justxxii.localplayer.dev'
const canonical = `${siteUrl}${path}`
const ogImage = `${siteUrl}/og.svg`

const chapters: readonly { id: string; label: string }[] = [
  { id: 'top', label: 'Prologue' },
  { id: 'works', label: 'Works' },
  { id: 'about', label: 'The Engineer' },
  { id: 'contact', label: 'Correspondence' }
]
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#141110" />
    <meta name="description" content={description} />
    <meta name="author" content="justxxi" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="justxxi" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" sizes="180x180" href="/touch-icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="intro" aria-hidden="true">
      <span class="intro__mark">justxxi</span>
      <div class="intro__panel"></div>
      <div class="intro__panel"></div>
    </div>

    <div class="frame" aria-hidden="true"></div>

    <slot />

    <nav class="spine" aria-label="Chapters">
      {chapters.map((chapter) => (
        <button
          class="spine__item serif"
          data-rail={chapter.id}
          aria-label={`Go to ${chapter.label}`}
        >
          {chapter.label}
        </button>
      ))}
    </nav>

    <div class="toast" id="toast" role="status" aria-live="polite">
      <span class="toast-dot" aria-hidden="true"></span>
      <span id="toast-text">Email copied to clipboard</span>
    </div>

    <script>
      import '../scripts/animations'
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: -100px;
    left: 1rem;
    z-index: 1100;
    padding: 0.6rem 1.2rem;
    background: var(--color-bone);
    color: var(--color-ground);
    font-size: 0.85rem;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .intro__panel {
    position: absolute;
    inset: 0;
    background: var(--color-ground);
    will-change: transform;
  }

  .intro__panel:nth-of-type(1) {
    top: auto;
    height: 51%;
    bottom: 49%;
  }

  .intro__panel:nth-of-type(2) {
    top: 51%;
    height: 49%;
  }

  .intro__mark {
    position: relative;
    z-index: 2;
  }

  .frame {
    position: fixed;
    inset: 14px;
    z-index: 85;
    border: 1px solid rgba(234, 228, 216, 0.09);
    pointer-events: none;
  }

  html.js .frame {
    animation: frame-in 1.6s var(--ease-out) 2.2s both;
  }

  @keyframes frame-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .spine {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2rem;
  }

  .spine__item {
    writing-mode: vertical-rl;
    padding: 0.4rem 0.85rem 0.4rem 0;
    border-right: 1px solid var(--color-line-soft);
    font-style: italic;
    font-size: 0.92rem;
    letter-spacing: 0.09em;
    color: var(--color-bone-muted);
    transition:
      color 0.45s var(--ease-out),
      transform 0.55s var(--ease-out),
      border-color 0.45s var(--ease-out);
  }

  .spine__item:hover {
    color: var(--color-bone);
  }

  .spine__item.is-active {
    color: var(--color-bone);
    border-right-color: var(--color-accent);
    transform: translateX(-10px);
  }

  @media (max-width: 1279px) {
    .spine {
      display: none;
    }
  }
</style>
