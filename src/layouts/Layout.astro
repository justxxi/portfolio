---
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
  path?: string
}

const {
  title = 'justxxi — full-stack developer',
  description = 'tools that are silent by design. python, go, ai systems, privacy tools.',
  path = Astro.url.pathname
}: Props = Astro.props

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://justxxii.localplayer.dev'
const canonical = `${siteUrl}${path}`
const ogImage = `${siteUrl}/og.svg`
---
<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfbfd" />
    <meta name="description" content={description} />
    <meta name="author" content="justxxi" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="justxxi" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="justxxi — full-stack developer" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/animations'
    </script>
  </body>
</html>
