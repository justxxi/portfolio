---
type NavLink = { label: string; href: string }

const links: readonly NavLink[] = [
  { label: 'projects', href: '#projects' },
  { label: 'about', href: '#about' },
  { label: 'contact', href: '#contact' }
] as const
---
<header class="nav" data-nav data-scrolled="false" role="banner">
  <div class="nav__inner">
    <a class="nav__mark" href="#top" aria-label="justxxi, return to top">
      <span class="nav__dot"></span>
      <span class="nav__title font-display">justxxi</span>
    </a>

    <nav class="nav__links" aria-label="primary">
      {links.map((link) => (
        <a class="nav__link" href={link.href}>{link.label}</a>
      ))}
      <button class="cmd-trigger font-mono" id="cmd-trigger-btn" aria-label="Open search shortcut">
        <span>⌘K</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    z-index: 100;
    background: rgba(15, 14, 13, 0.75);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--color-line-soft);
    transition: all 0.4s var(--ease-smooth);
  }

  .nav[data-scrolled='true'] {
    background: rgba(15, 14, 13, 0.94);
    border-bottom-color: rgba(200, 90, 60, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .nav__inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--page-pad);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  .nav__title {
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    font-weight: 700;
    color: var(--color-ink);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .nav__link {
    color: var(--color-ink-muted);
    font-size: 0.875rem;
    font-weight: 400;
    transition: color 0.25s var(--ease-smooth);
  }

  .nav__link:hover {
    color: var(--color-ink);
  }

  .cmd-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.55rem;
    font-size: 0.72rem;
    color: var(--color-ink-muted);
    background: rgba(245, 240, 232, 0.05);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    transition: all 0.25s var(--ease-smooth);
  }

  .cmd-trigger:hover {
    background: rgba(200, 90, 60, 0.15);
    color: var(--color-accent-hover);
    border-color: rgba(200, 90, 60, 0.3);
  }
</style>
