---
type NavLink = { label: string; href: string }

const links: readonly NavLink[] = [
  { label: 'work', href: '#work' },
  { label: 'about', href: '#about' },
  { label: 'contact', href: '#contact' }
] as const
---
<header class="nav" data-nav data-scrolled="false" role="banner">
  <div class="nav__inner">
    <a class="nav__mark" href="#top" aria-label="justxxi, return to top">justxxi</a>
    <nav class="nav__links" aria-label="primary">
      {links.map((link) => (
        <a class="nav__link" href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 52px;
    z-index: 100;
    background: rgba(251, 251, 253, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease-apple);
  }

  .nav[data-scrolled='true'] {
    border-bottom-color: var(--color-line-soft);
  }

  .nav__inner {
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--page-pad);
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__mark {
    color: var(--color-ink);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    animation: nav-fade 0.9s 0.8s var(--ease-apple) both;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .nav__link {
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 400;
    opacity: 0.88;
    transition: opacity 0.25s var(--ease-apple), color 0.25s var(--ease-apple);
    animation: nav-fade 0.9s var(--ease-apple) both;
  }

  .nav__link:nth-of-type(1) { animation-delay: 1.2s; }
  .nav__link:nth-of-type(2) { animation-delay: 1.3s; }
  .nav__link:nth-of-type(3) { animation-delay: 1.4s; }

  .nav__link:hover,
  .nav__link:focus-visible {
    opacity: 1;
    color: var(--color-accent);
  }

  @keyframes nav-fade {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 0.88; transform: translateY(0); }
  }

  @media (max-width: 540px) {
    .nav__inner { gap: 1rem; }
    .nav__links { gap: 1.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__mark,
    .nav__link { animation: none !important; opacity: 0.88; }
  }
</style>
