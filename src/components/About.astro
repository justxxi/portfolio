---
const stack: readonly { label: string; items: readonly string[] }[] = [
  {
    label: 'Engineering',
    items: ['Python & FastAPI', 'PyTorch, Transformers, LLM fine-tuning', 'Go microservices', 'TypeScript, Astro, React, Node.js']
  },
  {
    label: 'Infrastructure',
    items: ['Docker & Linux servers', 'PostgreSQL, Redis, pgvector', 'CI/CD & cloud deployment']
  }
]
---
<section class="about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__grid">
    <div class="about__left">
      <h2 class="about__quote serif" id="about-title" data-fade>
        Practical apps, custom models, clean backend code. <em>Built to last</em>.
      </h2>
      <p class="about__meta mono" data-fade>
        Middle Full-Stack &amp; AI Engineer &middot; 3+ years &middot; Remote
      </p>
    </div>

    <div class="about__right">
      <p class="about__body about__body--first" data-fade>
        I&rsquo;m a full-stack software engineer with three years of hands-on experience. My main
        stack is Python, Go and TypeScript; what drives me most is AI engineering and cloud
        infrastructure.
      </p>
      <p class="about__body" data-fade>
        I enjoy fine-tuning open-source LLMs, building neural network pipelines and setting up
        clean DevOps environments with Docker and Linux servers.
      </p>

      <div class="about__stack">
        {stack.map((group) => (
          <div class="stack-group" data-fade>
            <p class="stack-group__label mono">{group.label}</p>
            <ul role="list">
              {group.items.map((item) => (
                <li class="stack-group__item">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--color-line-soft);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .about__left {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: sticky;
    top: calc(var(--nav-h) + 3rem);
  }

  .about__quote {
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    max-width: 16ch;
  }

  .about__quote em {
    font-style: italic;
    color: var(--color-accent-bright);
  }

  .about__meta {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bone-muted);
  }

  .about__right {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding-top: 0.5rem;
  }

  .about__body {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-bone-muted);
    max-width: 52ch;
  }

  .about__body--first::first-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 3.4em;
    line-height: 0.76;
    float: left;
    padding: 0.06em 0.14em 0 0;
    color: var(--color-bone);
  }

  .about__stack {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .stack-group {
    display: grid;
    grid-template-columns: minmax(7.5rem, 10rem) 1fr;
    gap: 1.25rem;
    align-items: baseline;
  }

  .stack-group__label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }

  .stack-group ul {
    display: flex;
    flex-direction: column;
  }

  .stack-group__item {
    padding-block: 0.55rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__left {
      position: static;
    }

    .stack-group {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
