---
const techStack: readonly string[] = [
  'Python (FastAPI, PyTorch, Transformers)',
  'Go (Microservices & High-Concurrency)',
  'TypeScript (Astro, React, Node.js)',
  'AI Model Fine-Tuning & LLM Workflows',
  'Cloud Infrastructure & DevOps (Docker, Linux)',
  'PostgreSQL, Redis & Vector DBs (pgvector)'
] as const
---
<section class="about" id="about" data-section aria-labelledby="about-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">about me</p>
      <h2 class="section-title text-h2 font-display will-split" id="about-title">
        Behind the Code<span class="accent-dot">.</span>
      </h2>
    </header>

    <div class="about__grid">
      <div class="about__lead">
        <!--email_off-->
        <p class="about-quote font-display">
          &ldquo;I love building practical web apps, training custom AI models, and shipping clean backend code.&rdquo;
        </p>
        <p class="about-body">
          I&rsquo;m a full-stack software engineer with 3+ years of hands-on experience (Middle level). My main stack is Python, Go, and TypeScript, but what really drives me is AI engineering and cloud infrastructure.
        </p>
        <p class="about-body">
          I enjoy fine-tuning open-source LLMs, building custom neural network pipelines, and setting up clean DevOps environments with Docker and Linux servers.
        </p>
        <!--/email_off-->
        <div class="about-meta-box">
          <span class="meta-icon">●</span>
          <p class="about-meta">Middle Full-Stack &amp; AI Engineer &bull; 3+ years experience &bull; Remote</p>
        </div>
      </div>

      <aside class="about__caps card" aria-label="tech stack">
        <div class="caps__head">
          <p class="caps__label font-mono">Tech Stack &amp; Focus</p>
          <span class="caps__symbol font-mono">🛠</span>
        </div>
        <ul class="caps" role="list">
          {techStack.map((item) => (
            <li class="caps__item" data-cap>{item}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
    background: var(--color-surface-2);
    border-y: 1px solid var(--color-line-soft);
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .section-title {
    color: var(--color-ink);
  }

  .accent-dot {
    color: var(--color-accent);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .about__lead {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-quote {
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    line-height: 1.45;
    color: var(--color-ink);
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
  }

  .about-body {
    font-size: var(--text-lead);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 44ch;
  }

  .about-meta-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.2rem;
    background: rgba(99, 102, 241, 0.06);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: var(--radius-md);
    margin-top: 0.5rem;
  }

  .meta-icon {
    color: var(--color-accent);
    font-size: 0.6rem;
  }

  .about-meta {
    font-size: 0.85rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .about__caps {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .caps__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-line-soft);
  }

  .caps__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .caps__symbol {
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  .caps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .caps__item {
    font-size: var(--text-sm);
    color: var(--color-ink);
    position: relative;
    padding-left: 1.25rem;
  }

  .caps__item::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.75rem;
    color: #34d399;
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
