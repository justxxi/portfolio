---
const capabilities: readonly string[] = [
  'autonomous ai agents',
  'natural language processing',
  'cryptography & security',
  'cli tooling',
  'data pipeline architecture',
  'langgraph / pgvector',
  'steganography',
  'system design'
] as const
---
<section class="about" id="about" data-section aria-labelledby="about-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">about</p>
      <h2 class="section-title text-h2 font-display will-split" id="about-title">
        Quiet precision.<br />
        <span class="muted">Built to disappear.</span>
      </h2>
    </header>

    <div class="about__grid">
      <div class="about__lead">
        <!--email_off-->
        <p class="about-body">
          I build tools that are silent by design. Most of what I make is invisible &mdash; that&rsquo;s the point.
        </p>
        <p class="about-body">
          I think about privacy, autonomy, and the aesthetics of utility. Tools should disappear into the task. I work in Python and Go, and treat AI as infrastructure, not magic.
        </p>
        <!--/email_off-->
        <p class="about-meta">Full-stack developer, 3+ years. Open to remote roles and collaborations.</p>
      </div>

      <aside class="about__caps card" aria-label="capabilities">
        <p class="caps__label">Capabilities</p>
        <ul class="caps" role="list">
          {capabilities.map((cap) => (
            <li class="caps__item" data-cap>{cap}</li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section-gap);
    background: var(--color-surface-2);
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-title {
    color: var(--color-ink);
  }

  .section-title .muted {
    color: var(--color-ink-muted);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .about__lead {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 0.5rem;
  }

  .about-body {
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    max-width: 38ch;
  }

  .about-meta {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-top: 0.75rem;
  }

  .about__caps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .caps__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
  }

  .caps {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem 1rem;
  }

  .caps__item {
    font-size: var(--text-sm);
    color: var(--color-ink);
    position: relative;
    padding-left: 1rem;
  }

  .caps__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  @media (max-width: 820px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .caps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .caps {
      grid-template-columns: 1fr;
    }
  }
</style>
