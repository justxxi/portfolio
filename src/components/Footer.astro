---
const year: number = new Date().getFullYear()
---
<footer class="footer" data-footer role="contentinfo">
  <div class="wrap footer__inner">
    <span class="footer__year font-mono text-xs" data-footer-item>© {year} justxxi</span>
    <a
      class="footer-link font-mono text-xs"
      href="https://github.com/justxxi/portfolio"
      target="_blank"
      rel="noopener noreferrer"
      data-footer-item
      data-hover
    >source</a>
    <a class="footer-link font-mono text-xs" href="#top" data-footer-item data-hover>back to top</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(5vh, 8vh, 10vh);
    border-top: 1px solid var(--color-line);
  }

  .footer__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__year {
    color: var(--color-ink-muted);
    opacity: 0.5;
    letter-spacing: 0.15em;
    text-transform: lowercase;
  }

  .footer .footer-link {
    text-transform: lowercase;
  }

  @media (max-width: 540px) {
    .footer__inner {
      justify-content: center;
      gap: 1rem;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
