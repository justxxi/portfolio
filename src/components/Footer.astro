---
const year: number = new Date().getFullYear()
---
<footer class="footer" role="contentinfo">
  <div class="wrap footer__inner">
    <p class="label">&copy; {year} justxxi</p>
    <nav class="footer__links" aria-label="Footer">
      <a class="link-line" href="https://github.com/justxxi/portfolio" target="_blank" rel="noopener noreferrer">Source</a>
      <a class="link-line" href="#top">Back to top</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(1.75rem, 4vh, 2.75rem);
    border-top: 1px solid var(--color-line-soft);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2rem);
  }
</style>
