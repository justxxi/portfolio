---
const year: number = new Date().getFullYear()
---
<footer class="footer" data-footer role="contentinfo">
  <div class="wrap footer__inner">
    <span class="footer__year font-mono text-xs" data-footer-item>© {year} justxxi</span>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(6vh, 10vh, 12vh);
    border-top: 1px solid var(--color-line);
  }

  .footer__inner {
    display: flex;
    justify-content: center;
  }

  .footer__year {
    color: var(--color-ink-muted);
    opacity: 0.4;
    letter-spacing: 0.15em;
  }
</style>
