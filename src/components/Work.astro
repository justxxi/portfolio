---
type GitHubRepo = {
  id: number
  name: string
  description: string | null
  html_url: string
  stargazers_count: number
  language: string | null
  updated_at: string
  fork: boolean
}

// Fallback repositories data
const fallbackRepos = [
  {
    name: 'toxiguard',
    description: 'Real-time NLP toxicity classification engine. Classifies six toxicity dimensions with sub-100ms inference.',
    language: 'Python',
    stargazers_count: 12,
    html_url: 'https://github.com/justxxi/toxiguard',
    updated_at: '2026-07-28'
  },
  {
    name: 'consul',
    description: 'Fully local LLM assistant with zero external API calls. Runs on consumer hardware, stores context in encrypted SQLite.',
    language: 'Python',
    stargazers_count: 8,
    html_url: 'https://github.com/justxxi/consul',
    updated_at: '2026-07-15'
  },
  {
    name: 'phantom',
    description: 'Diceware-style passphrases & high-entropy password generator relying on OS hardware entropy pool.',
    language: 'Python',
    stargazers_count: 15,
    html_url: 'https://github.com/justxxi/phantom',
    updated_at: '2026-06-30'
  },
  {
    name: 'hush',
    description: 'Conceals up to 10KB of plaintext inside PNG image matrices via LSB substitution with AES-256 encryption.',
    language: 'Python',
    stargazers_count: 19,
    html_url: 'https://github.com/justxxi/hush',
    updated_at: '2026-06-12'
  },
  {
    name: 'umbra',
    description: 'Maps luminance to a curated unicode glyph grid with density balance and aspect ratio correction.',
    language: 'Python',
    stargazers_count: 24,
    html_url: 'https://github.com/justxxi/umbra',
    updated_at: '2026-05-20'
  }
]

let liveRepos: any[] = fallbackRepos

try {
  const res = await fetch('https://api.github.com/users/justxxi/repos?sort=updated&per_page=12', {
    headers: { 'User-Agent': 'justxxi-portfolio-builder' }
  })
  if (res.ok) {
    const data: GitHubRepo[] = await res.json()
    const filtered = data.filter((r) => !r.fork && r.name.toLowerCase() !== 'portfolio' && r.name.toLowerCase() !== 'justxxi')
    if (filtered.length > 0) {
      liveRepos = filtered.map((r) => ({
        name: r.name,
        description: r.description || 'Open source software project built by justxxi.',
        language: r.language || 'Code',
        stargazers_count: r.stargazers_count,
        html_url: r.html_url,
        updated_at: r.updated_at.split('T')[0]
      }))
    }
  }
} catch (e) {
  // Use fallback if API fails or rate limited
}
---
<section class="work" id="projects" data-section aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head">
      <div class="repo-sync-badge">
        <span class="sync-dot"></span>
        <span>Synced with GitHub API (@justxxi)</span>
      </div>
      <h2 class="section-title text-h2 font-display will-split" id="work-title">
        Open Source Repositories<span class="accent-dot">.</span>
      </h2>
      <p class="section-sub text-lead">
        Public code repositories fetched live from GitHub. Built for utility, security, and performance.
      </p>
    </header>

    <div class="repos__grid" id="repos-container" role="list">
      {liveRepos.map((repo) => (
        <article class="repo-card card" role="listitem">
          <div class="repo__top">
            <div class="repo__meta">
              <span class="lang-badge">
                <span class="lang-dot" data-lang={repo.language}></span>
                <span>{repo.language}</span>
              </span>
              <span class="star-badge">
                ★ <span>{repo.stargazers_count}</span>
              </span>
            </div>
            <a
              class="repo__link"
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${repo.name} repository on GitHub`}
            >
              <span>GitHub ↗</span>
            </a>
          </div>

          <div class="repo__head">
            <h3 class="repo__name font-display">{repo.name}</h3>
          </div>

          <p class="repo__desc text-body">{repo.description}</p>

          <div class="repo__foot">
            <span class="repo__date font-mono">Updated: {repo.updated_at}</span>
            <button
              class="repo__details-btn"
              data-project-json={JSON.stringify({
                name: repo.name,
                tagline: `${repo.language} repository`,
                description: repo.description,
                tags: [repo.language?.toLowerCase() || 'code', 'open-source', 'github'],
                repo: repo.html_url
              })}
              aria-label={`View modal details for ${repo.name}`}
            >
              <span>Details →</span>
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-gap);
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .repo-sync-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.78rem;
    color: #34d399;
    font-family: var(--font-mono);
  }

  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px #34d399;
  }

  .section-title {
    color: var(--color-ink);
    max-width: 22ch;
  }

  .accent-dot {
    color: var(--color-accent);
  }

  .section-sub {
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .repos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(1.2rem, 2vw, 1.8rem);
  }

  .repo-card {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-height: 250px;
  }

  .repo__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .repo__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .repo__link {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent-hover);
  }

  .repo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .repo__name {
    color: var(--color-ink);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    letter-spacing: -0.015em;
  }

  .repo__desc {
    color: var(--color-ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    flex: 1;
  }

  .repo__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line-soft);
  }

  .repo__date {
    font-size: 0.72rem;
    color: var(--color-ink-muted);
  }

  .repo__details-btn {
    font-size: 0.8rem;
    color: var(--color-accent-hover);
    font-weight: 500;
  }
</style>
