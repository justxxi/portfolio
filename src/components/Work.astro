---
type Project = {
  name: string
  tagline: string
  description: string
  tags: readonly string[]
  repo: string
}

const projects: readonly Project[] = [
  {
    name: 'meridian',
    tagline: 'autonomous market intelligence.',
    description: 'ingests 40+ public and private data sources, ranks signals by relevance, and delivers structured briefings. langgraph state machines, pgvector retrieval, ~10k documents per run.',
    tags: ['python', 'go', 'langgraph', 'pgvector'],
    repo: 'https://github.com/justxxi/meridian'
  },
  {
    name: 'toxiguard',
    tagline: 'real-time toxicity detection.',
    description: 'telegram bot deployed in communities up to 5k members. classifies six toxicity dimensions with sub-100ms inference. auto-moderation by configurable threshold.',
    tags: ['python', 'nlp', 'telegram'],
    repo: 'https://github.com/justxxi/toxiguard'
  },
  {
    name: 'consul',
    tagline: 'sovereignty over your data.',
    description: 'fully local llm assistant. zero external api calls. runs on consumer hardware, stores context in sqlite, never phones home.',
    tags: ['python', 'privacy', 'local'],
    repo: 'https://github.com/justxxi/consul'
  },
  {
    name: 'phantom',
    tagline: 'cryptographic passphrases.',
    description: 'diceware-style passphrases and high-entropy passwords via os.urandom. entropy estimation, no network, no storage, standard library only.',
    tags: ['python', 'cli', 'cryptography'],
    repo: 'https://github.com/justxxi/phantom'
  },
  {
    name: 'hush',
    tagline: 'conceal text within pixels.',
    description: 'embeds up to 10kb of plaintext inside a png. lsb substitution with aes-256, passphrase-derived keys. survives re-compression where possible.',
    tags: ['python', 'steganography'],
    repo: 'https://github.com/justxxi/hush'
  },
  {
    name: 'umbra',
    tagline: 'images to ascii.',
    description: 'maps luminance to a curated unicode glyph set with configurable density and aspect correction. handles 4k images in under a second.',
    tags: ['python', 'cli', 'ascii'],
    repo: 'https://github.com/justxxi/umbra'
  }
] as const
---
<section class="work" id="work" data-section aria-labelledby="work-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">selected work</p>
      <h2 class="section-title text-h2 font-display will-split" id="work-title">
        Built with intent.
      </h2>
      <p class="section-sub text-lead">
        Six projects. Each one designed to disappear into the task.
      </p>
    </header>

    <div class="work__grid" role="list">
      {projects.map((p, i) => (
        <article class="project card" role="listitem" style={`--i:${i}`}>
          <div class="project__head">
            <h3 class="project__name text-h3 font-display">{p.name}</h3>
            <p class="project__tagline">{p.tagline}</p>
          </div>
          <p class="project__desc text-body">{p.description}</p>
          <div class="project__foot">
            <ul class="project__tags" aria-label={`${p.name} stack`}>
              {p.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
            <a
              class="link-arrow project__cta"
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`view ${p.name} repository on github`}
            >
              View repo
              <span class="arrow" aria-hidden="true">›</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-gap);
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-title {
    color: var(--color-ink);
    max-width: 18ch;
  }

  .section-sub {
    color: var(--color-ink-muted);
    max-width: 42ch;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 280px;
  }

  .project__head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .project__name {
    color: var(--color-ink);
    text-transform: lowercase;
  }

  .project__tagline {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .project__desc {
    color: var(--color-ink-muted);
    flex: 1;
  }

  .project__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    background: var(--color-surface-2);
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    letter-spacing: 0;
  }

  .project__cta {
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
  }

  .project__cta .arrow {
    font-size: 1.1em;
  }
</style>
