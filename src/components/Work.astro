---
interface GitHubRepo {
  readonly name: string
  readonly description: string | null
  readonly html_url: string
  readonly stargazers_count: number
  readonly language: string | null
  readonly updated_at: string
  readonly fork: boolean
}

interface RepoItem {
  readonly name: string
  readonly description: string
  readonly language: string
  readonly stars: number
  readonly url: string
}

const fallbackRepos: readonly RepoItem[] = [
  {
    name: 'ai-orchestrator',
    description: 'Pipeline for fine-tuning open-source LLMs, custom neural network workflows and vector retrieval.',
    language: 'Python',
    stars: 14,
    url: 'https://github.com/justxxi'
  },
  {
    name: 'cloud-backend',
    description: 'High-concurrency microservices, REST/gRPC APIs and async task processing in Go and Python.',
    language: 'Go',
    stars: 19,
    url: 'https://github.com/justxxi'
  },
  {
    name: 'privacy-engine',
    description: 'Local data encryption tools, hardware-entropy credential generation and offline utility engines.',
    language: 'Python',
    stars: 11,
    url: 'https://github.com/justxxi'
  },
  {
    name: 'devops-toolkit',
    description: 'Automated deployment configurations, container orchestration and server automation scripts.',
    language: 'TypeScript',
    stars: 16,
    url: 'https://github.com/justxxi'
  }
]

let repos: readonly RepoItem[] = fallbackRepos

try {
  const res = await fetch('https://api.github.com/users/justxxi/repos?sort=updated&per_page=12', {
    headers: { 'User-Agent': 'justxxi-portfolio-builder' }
  })
  if (res.ok) {
    const data: readonly GitHubRepo[] = await res.json()
    const filtered = data.filter(
      (r) => !r.fork && r.name.toLowerCase() !== 'portfolio' && r.name.toLowerCase() !== 'justxxi'
    )
    if (filtered.length > 0) {
      repos = filtered.map((r) => ({
        name: r.name,
        description: r.description || 'Open-source software project built by justxxi.',
        language: r.language || 'Code',
        stars: r.stargazers_count,
        url: r.html_url
      }))
    }
  }
} catch {}
---
<section class="works" id="works" aria-labelledby="works-title">
  <div class="wrap">
    <header class="works__head">
      <h2 class="works__title serif" id="works-title">
        <span class="mask"><span class="mask__inner" data-reveal>Selected works</span></span>
      </h2>
      <p class="works__count mono" data-fade>({String(repos.length).padStart(2, '0')})</p>
    </header>

    <ul class="index" role="list">
      {repos.map((repo, i) => (
        <li>
          <a
            class="row"
            href={repo.url}
            target="_blank"
            rel="noopener noreferrer"
            data-row
            aria-label={`${repo.name}, ${repo.language}, ${repo.stars} stars, open on GitHub`}
          >
            <span class="row__num serif">Cat.&nbsp;{String(i + 1).padStart(2, '0')}</span>
            <span class="row__main">
              <span class="row__name serif">{repo.name}</span>
              <span class="row__desc">{repo.description}</span>
            </span>
            <span class="row__side mono">
              <span>{repo.language}</span>
              <span>&#9733; {repo.stars}</span>
            </span>
            <span class="row__arrow" aria-hidden="true">&nearr;</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="works__foot">
      <a class="link-line" href="https://github.com/justxxi" target="_blank" rel="noopener noreferrer">
        Full archive on GitHub</a>
    </div>
  </div>
</section>

<style>
  .works {
    padding-block: var(--section-gap);
  }

  .works__head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 6vh, 4.5rem);
  }

  .works__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .works__count {
    font-size: 0.8rem;
    color: var(--color-accent-bright);
  }

  .index li {
    border-top: 1px solid var(--color-line-soft);
  }

  .index li:last-child {
    border-bottom: 1px solid var(--color-line-soft);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 5.5rem 1fr auto 2rem;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.4rem, 3vh, 2rem);
    isolation: isolate;
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-ground-deep);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s var(--ease-out);
  }

  .row:hover::before {
    transform: scaleY(1);
    transform-origin: bottom;
  }

  .row__num {
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    color: var(--color-bone-muted);
    transition: color 0.35s var(--ease-out);
  }

  .row:hover .row__num {
    color: var(--color-accent-bright);
  }

  .row__main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .row__name {
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    transition: transform 0.45s var(--ease-out);
  }

  .row:hover .row__name {
    transform: translateX(14px);
  }

  .row__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-bone-muted);
    max-width: 56ch;
  }

  .row__side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-bone-muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .row__arrow {
    font-size: 1.15rem;
    color: var(--color-accent-bright);
    opacity: 0;
    transform: translate(-8px, 8px);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .row:hover .row__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .works__foot {
    display: flex;
    justify-content: center;
    padding-top: clamp(2.25rem, 5vh, 3.5rem);
  }

  @media (max-width: 720px) {
    .row {
      grid-template-columns: 1fr;
      row-gap: 0.75rem;
    }

    .row__side {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
    }

    .row__arrow {
      display: none;
    }
  }
</style>
