---
type Link = {
  label: string
  value: string
  href: string
  hint: string
}

const links: readonly Link[] = [
  { label: 'Email', value: 'wyurtrft@proton.me', href: 'mailto:wyurtrft@proton.me', hint: 'preferred for work inquiries' },
  { label: 'Telegram', value: '@nevercriesonlylaugh', href: 'https://t.me/nevercriesonlylaugh', hint: 'fastest reply' },
  { label: 'LinkedIn', value: 'in/cryinparis', href: 'https://www.linkedin.com/in/cryinparis', hint: 'professional network' },
  { label: 'GitHub', value: 'justxxi', href: 'https://github.com/justxxi', hint: 'open source work' }
] as const
---
<section class="contact" id="contact" data-section aria-labelledby="contact-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">contact</p>
      <h2 class="section-title text-h2 font-display will-split" id="contact-title">
        Let&rsquo;s build something quiet.
      </h2>
      <p class="section-sub text-lead">
        Open to remote roles, collaborations, and problems worth solving.
      </p>
    </header>

    <ul class="contact__grid" role="list">
      {links.map((link) => (
        <li role="listitem">
          <a
            class="contact-card card"
            href={link.href}
            target={link.href.startsWith('mailto:') ? undefined : '_blank'}
            rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            aria-label={`${link.label}: ${link.value}`}
          >
            <div class="contact-card__top">
              <span class="contact-card__label">{link.label}</span>
              <span class="contact-card__arrow" aria-hidden="true">›</span>
            </div>
            <p class="contact-card__value">{link.value}</p>
            <p class="contact-card__hint">{link.hint}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-gap);
  }

  .section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-title {
    color: var(--color-ink);
    max-width: 18ch;
  }

  .section-sub {
    color: var(--color-ink-muted);
    max-width: 42ch;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    list-style: none;
    padding: 0;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--color-ink);
  }

  .contact-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact-card__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-muted);
  }

  .contact-card__arrow {
    color: var(--color-ink-muted);
    font-size: 1.2rem;
    transition: transform 0.4s var(--ease-apple), color 0.3s var(--ease-apple);
  }

  .contact-card:hover .contact-card__arrow {
    transform: translateX(3px);
    color: var(--color-accent);
  }

  .contact-card__value {
    font-size: var(--text-lead);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .contact-card__hint {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-top: 0.25rem;
  }
</style>
