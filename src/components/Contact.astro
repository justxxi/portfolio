---
const email = 'wyurtrft@proton.me'
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 class="contact__title serif" id="contact-title">
      <span class="mask"><span class="mask__inner" data-reveal>Correspondence</span></span>
    </h2>
    <p class="contact__sub" data-fade>
      Open to remote engineering roles, backend contracts and technical collaborations.
    </p>

    <button class="email" type="button" data-copy-email={email} data-fade>
      <span class="email__text serif">{email}</span>
      <span class="email__hint label">Click to copy</span>
    </button>
    <div class="hairline email__rule" data-line></div>

    <div class="contact__links" data-fade>
      <span class="label">Elsewhere</span>
      <a class="link-line" href="https://github.com/justxxi" target="_blank" rel="noopener noreferrer">
        github.com/justxxi</a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-gap);
    border-top: 1px solid var(--color-line-soft);
  }

  .contact__title {
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .contact__sub {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    max-width: 44ch;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-bone-muted);
  }

  .email {
    display: block;
    width: 100%;
    text-align: left;
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
    padding-bottom: 0.85rem;
  }

  .email__text {
    display: inline-block;
    font-size: clamp(1.8rem, 6.5vw, 5.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    transition:
      color 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .email:hover .email__text {
    color: var(--color-accent);
    transform: translateX(10px);
  }

  .email__hint {
    display: block;
    margin-top: 0.75rem;
  }

  .email__rule {
    margin-bottom: clamp(1.75rem, 4vh, 2.75rem);
  }

  .contact__links {
    display: flex;
    align-items: baseline;
    gap: 1.75rem;
  }
</style>
