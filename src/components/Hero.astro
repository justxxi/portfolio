---
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__inner">
    <p class="hero__eyebrow">full-stack developer</p>
    <h1 class="hero__title text-display font-display" id="hero-title">justxxi.</h1>
    <p class="hero__lead text-lead">
      Tools that are silent by design.<br />
      Python, Go, AI systems, and privacy.
    </p>
    <div class="hero__actions">
      <a class="pill pill--primary" href="#work">
        View work
        <span class="arrow" aria-hidden="true">›</span>
      </a>
      <a class="pill pill--ghost" href="#contact">
        Get in touch
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92dvh;
    display: grid;
    place-items: center;
    padding: clamp(7rem, 14vh, 9rem) var(--page-pad) clamp(4rem, 8vh, 6rem);
    text-align: center;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0, 102, 204, 0.04), transparent 60%),
      var(--color-ground);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: 920px;
  }

  .hero__eyebrow {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: -0.005em;
    animation: hero-rise 1s 0.8s var(--ease-apple) both;
  }

  .hero__title {
    color: var(--color-ink);
    margin: 0;
    animation: hero-focus 1.4s var(--ease-apple) both;
  }

  .hero__lead {
    color: var(--color-ink-muted);
    max-width: 36ch;
    margin-top: 0.5rem;
    animation: hero-rise 1.1s 1.1s var(--ease-apple) both;
  }

  .hero__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    flex-wrap: wrap;
    justify-content: center;
    animation: hero-rise 1.1s 1.4s var(--ease-apple) both;
  }

  .hero__actions .arrow {
    font-size: 1.1em;
    transform: translateY(-1px);
    transition: transform 0.3s var(--ease-apple);
  }

  .hero__actions .pill--primary:hover .arrow {
    transform: translate(2px, -1px);
  }

  @keyframes hero-focus {
    0% {
      filter: blur(14px);
      transform: scale(1.04);
      letter-spacing: -0.01em;
    }
    100% {
      filter: blur(0);
      transform: scale(1);
      letter-spacing: -0.035em;
    }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title,
    .hero__lead,
    .hero__eyebrow,
    .hero__actions {
      animation: none !important;
      filter: none !important;
      transform: none !important;
    }
  }
</style>
