---
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <h1 class="hero__title serif" id="hero-title">
      <span class="mask"><span class="mask__inner" data-hero-line>Full-stack <em>&amp;</em></span></span>
      <span class="mask"><span class="mask__inner" data-hero-line><em>AI</em> engineer</span></span>
    </h1>

    <div class="hero__foot">
      <p class="hero__lead" data-fade>
        I&rsquo;m justxxi. I build web applications, cloud backends and custom AI
        models with Python, Go and TypeScript.
      </p>
      <div class="hero__actions" data-fade>
        <a class="btn-solid" href="#works" data-magnet>
          <span>Selected works</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="link-line" href="#contact">Get in touch</a>
      </div>
    </div>

    <div class="hero__meta" data-fade>
      <span class="label">&copy;MMXXVI</span>
      <span class="hero__meta-time label">Local time&nbsp;<span class="mono" id="clock">00:00:00</span></span>
      <span class="label">Remote &middot; Worldwide</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--nav-h) + clamp(2rem, 8vh, 5rem));
    padding-bottom: clamp(1.5rem, 4vh, 2.75rem);
    gap: clamp(2rem, 5vh, 3.5rem);
  }

  .hero__title {
    font-size: clamp(3.4rem, 11.5vw, 9.25rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    font-weight: 500;
    margin-top: auto;
  }

  .hero__title em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent-bright);
  }

  .hero__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 4rem);
    flex-wrap: wrap;
  }

  .hero__lead {
    max-width: 42ch;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-bone-muted);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    flex-wrap: wrap;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line-soft);
  }

  .hero__meta .mono {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-bone);
  }

  @media (max-width: 640px) {
    .hero__meta span:nth-child(2) {
      display: none;
    }
  }
</style>
